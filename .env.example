# Copy to .env for local development. NEVER commit .env.
# Supabase: Connect > Session pooler connection string (port 5432). Do not add ?sslmode=...
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Only for a local Postgres without SSL:
# DATABASE_SSL=disable

# Optional, stronger: Supabase CA certificate (Database Settings > SSL), with \n for line breaks
# DATABASE_CA_CERT=

PORT=3000
